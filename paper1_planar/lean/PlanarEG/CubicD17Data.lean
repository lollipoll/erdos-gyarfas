/-- Token IDs for the `108` `d = 17` discharging residuals: 0=C_T1R_TPsL, 1=C_TPsR_H_TPsL, 2=C_TPsR_T1L, 3=N, 4=R10, 5=T, 6=T10, 7=T1_L, 8=T1_R, 9=TP_s_L, 10=TP_s_R -/
def tokId_R10 : Nat := 4
def tokId_CTPsRHTPsL : Nat := 1
def tokId_T1R : Nat := 8
def tokId_T1L : Nat := 7
def tokId_N : Nat := 3
def tokId_L : Nat := 0
def tokId_R : Nat := 2
def tokId_T : Nat := 5
def d17TokLen : Nat → Nat
  | 0 => 4
  | 1 => 5
  | 2 => 4
  | 3 => 1
  | 4 => 1
  | 5 => 1
  | 6 => 1
  | 7 => 2
  | 8 => 2
  | 9 => 2
  | 10 => 2
  | _ => 0

def seqLenSum : List Nat → Nat
  | [] => 0
  | x :: xs => d17TokLen x + seqLenSum xs

def rotateAt (k : Nat) (xs : List Nat) : List Nat := xs.drop k ++ xs.take k

def orbitCodeOf (a b c : Nat) : Option Nat :=
  let tag (x : Nat) : Option Nat :=
    if x == tokId_L then some 0
    else if x == tokId_R then some 1
    else if x == tokId_T then some 2
    else none
  match tag a, tag b, tag c with
  | some 0, some 0, some 2 => some 0
  | some 0, some 1, some 2 => some 1
  | some 0, some 2, some 0 => some 2
  | some 0, some 2, some 1 => some 3
  | some 1, some 0, some 2 => some 4
  | some 1, some 1, some 2 => some 5
  | some 1, some 2, some 0 => some 6
  | some 1, some 2, some 1 => some 7
  | some 2, some 0, some 0 => some 8
  | some 2, some 0, some 1 => some 9
  | some 2, some 1, some 0 => some 10
  | some 2, some 1, some 1 => some 11
  | _, _, _ => none

def isR10Residual (seq : List Nat) : Bool :=
  (seqLenSum seq == 17) && seq.contains tokId_R10 && seq.contains tokId_CTPsRHTPsL

def isOrbitResidual (oid k : Nat) (seq : List Nat) : Bool :=
  if seqLenSum seq != 17 then false
  else match rotateAt k seq with
    | [t0, t1, n0, a, n1, b, n2, c, n3] =>
      t0 == tokId_T1R && t1 == tokId_T1L &&
      n0 == tokId_N && n1 == tokId_N && n2 == tokId_N && n3 == tokId_N &&
      orbitCodeOf a b c == some oid
    | _ => false

